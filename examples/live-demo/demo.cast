{"version": 2, "width": 110, "height": 35, "timestamp": 0, "title": "Reproducibility Doctor \u2014 genuine evidence, read-only replay"}
[0.0, "o", "Read-only replay of actual CLI diagnosis output from genuine manually approved runs.\r\nNo target command, approval, image pull or Docker call is made by this generator.\r\nEntry point shown as reprodoctor; captured via python -I -m reprodoctor.\r\nProject paths are normalized. Replay timing is paced, not a screen recording.\r\nFrozen corpus: 7 executions, 5 abstentions. Tiny public sample; no general accuracy claim.\r\n"]
[10.0, "o", "$ reprodoctor diagnose examples/runtime-dev-01.json --format json\r\n{\r\n  \"schema_version\": 1,\r\n  \"kind\": \"diagnosis_report\",\r\n  \"tool_version\": \"0.1.0.dev0\",\r\n  \"repository\": {\r\n    \"commit\": \"0f4b3461e1127174b1efd595b34d8a1ec926d5c2\",\r\n    \"content_digest\": \"3c27a5478f5948e849dc5fad2638c1bfa28088ac9a9153abf80650ef98cf611a\"\r\n  },\r\n  \"plan_digest\": \"d13f485b66f52137ddf8ea8692cd2679460dc80e22a34275127b9f5effe02135\",\r\n  \"execution_status\": \"completed\",\r\n  \"experimental\": true,\r\n  \"live_validation\": \"pending\",\r\n  \"findings\": [],\r\n  \"limitations\": [\r\n    \"This interprets an editable local execution record; it does not authenticate the record or rerun commands.\",\r\n    \"Logs are untrusted and may be forged, incomplete or truncated. Pattern matches are suggestions only.\",\r\n    \"No match means unknown cause. Successful commands are not proof of reproducibility or application correctness.\",\r\n    \"Docker CLI and program exit codes can be ambiguous; no signal or exact root cause is inferred.\"\r\n  ]\r\n}\r\n"]
[20.0, "o", "$ reprodoctor diagnose examples/runtime-dev-02.json --format json\r\n{\r\n  \"schema_version\": 1,\r\n  \"kind\": \"diagnosis_report\",\r\n  \"tool_version\": \"0.1.0.dev0\",\r\n  \"repository\": {\r\n    \"commit\": \"3a166f3ceeb46860af4b2e49484ced23f60f7781\",\r\n    \"content_digest\": \"a1a228ec3b160d7bdd391f67cc31e77836aa83ea2c30c87007e28a1c990fbaf4\"\r\n  },\r\n  \"plan_digest\": \"0ab1276a0813037ba28356e604e16000b800957345c5f6b5ce1d8afa7a3561e1\",\r\n  \"execution_status\": \"failed\",\r\n  \"experimental\": true,\r\n  \"live_validation\": \"pending\",\r\n  \"findings\": [\r\n    {\r\n      \"id\": \"diagnosis-0001\",\r\n      \"category\": \"command_failed\",\r\n      \"kind\": \"observation\",\r\n      \"observed_fact\": \"Step instruction-0001 has recorded status failed and exit code 1.\",\r\n      \"suggested_action\": \"Review the effective argv, bounded logs and source instruction. A CLI exit status alone does not identify a root cause.\",\r\n      \"evidence\": {\r\n        \"step_id\": \"instruction-0001\",\r\n        \"json_pointer\": \"/steps/0\",\r\n        \"source\": {\r\n          \"id\": \"instruction-0001\",\r\n          \"order\": 1,\r\n          \"block_id\": \"block-0001\",\r\n          \"path\": \"README.md\",\r\n          \"start_line\": 3,\r\n          \"end_line\": 3,\r\n          \"raw_text\": \"python -m pip install -r absent.txt\\n\",\r\n          \"candidate_text\": \"python -m pip install -r absent.txt\",\r\n          \"phase\": \"installation\",\r\n          \"command_phase\": \"installation\",\r\n          \"heading_phase\": \"installation\",\r\n          \"heading_context\": [\r\n            {\r\n              \"level\": 1,\r\n              \"text\": \"Install\",\r\n              \"line\": 1\r\n            }\r\n          ],\r\n          \"classification\": \"command_candidate\",\r\n          \"ambiguity_reasons\": [],\r\n          \"requires_review\": true\r\n        },\r\n        \"exit_code\": 1,\r\n        \"exit_code_source\": \"docker_exec_cli\",\r\n        \"signal\": null\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"diagnosis-0002\",\r\n      \"category\": \"missing_file\",\r\n      \"kind\": \"suggestion\",\r\n      \"observed_fact\": \"The recorded stderr contains text matching missing_file; this is a possible cause, not verified truth.\",\r\n      \"suggested_action\": \"Check the referenced path against the pinned source and earlier generated files.\",\r\n      \"evidence\": {\r\n        \"step_id\": \"instruction-0001\",\r\n        \"json_pointer\": \"/steps/0/stderr/text\",\r\n        \"character_span\": [\r\n          51,\r\n          76\r\n        ],\r\n        \"excerpt\": \"ERROR: Could not open requirements file: [Errno 2] No such file or directory: 'absent.txt'\\n\",\r\n        \"retained_text_sha256\": \"05d29d598addf7b943a6564c8b0ca5d72600d657fa0da609d45a6f91f8e2c529\",\r\n        \"truncated\": false\r\n      }\r\n    }\r\n  ],\r\n  \"limitations\": [\r\n    \"This interprets an editable local execution record; it does not authenticate the record or rerun commands.\",\r\n    \"Logs are untrusted and may be forged, incomplete or truncated. Pattern matches are suggestions only.\",\r\n    \"No match means unknown cause. Successful commands are not proof of reproducibility or application correctness.\",\r\n    \"Docker CLI and program exit codes can be ambiguous; no signal or exact root cause is inferred.\"\r\n  ]\r\n}\r\n"]
